<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Pgmq</RootNamespace>
        <PackageId>Pgmq</PackageId>
        <Description>Strongly typed publishing over PGMQ queues in PostgreSQL: fan-out to subscribed queues, topic routing, FIFO groups, delayed delivery, message headers, tracing and queue management. The core of Pgmq.NET; see Pgmq.Hosting for consumers.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <!-- pgmq's own SQL (v1.13.1, PostgreSQL License; see Sql/LICENSE): the install and every upgrade script, so the
         migrator can install pgmq where the extension is unavailable. Refresh from pgmq-extension/sql upstream. -->
    <ItemGroup>
        <EmbeddedResource Include="Sql\*.sql;Sql\pgmq.control" LogicalName="Pgmq.Sql.%(Filename)%(Extension)" />
        <None Include="Sql\LICENSE" Pack="true" PackagePath="licenses\pgmq" />
    </ItemGroup>

    <!-- Pgmq.NET's one addition to pgmq: pgmq.shovel, created by the migrator after pgmq. -->
    <ItemGroup>
        <EmbeddedResource Include="shovel.sql" LogicalName="Pgmq.shovel.sql" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Pgmq.Hosting" />
        <InternalsVisibleTo Include="Pgmq.Tests" />
        <InternalsVisibleTo Include="Pgmq.Hosting.Tests" />
        <InternalsVisibleTo Include="Pgmq.IntegrationTests" />
        <InternalsVisibleTo Include="Pgmq.Benchmarks" />
    </ItemGroup>
</Project>
